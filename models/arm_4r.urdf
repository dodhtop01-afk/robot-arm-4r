<?xml version="1.0"?>
<robot name="robot_arm_4r">

  <!-- MATERIALS -->
  <material name="blue">
    <color rgba="0.15 0.40 0.85 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>

  <!-- BASE LINK -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <cylinder radius="0.06" length="0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- ROTATING BASE -->
  <link name="base_rotation">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <cylinder radius="0.035" length="0.10"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- JOINT 1: BASE ROTATION -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="base_rotation"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14"
           effort="5" velocity="1"/>
  </joint>

  <!-- LINK 2: UPPER ARM -->
  <link name="upper_arm">
    <visual>
      <origin xyz="0.075 0 0"/>
      <geometry>
        <box size="0.15 0.035 0.035"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- JOINT 2: SHOULDER -->
  <joint name="joint2" type="revolute">
    <parent link="base_rotation"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.10"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.57" upper="1.57"
           effort="5" velocity="1"/>
  </joint>

  <!-- LINK 3: FOREARM -->
  <link name="forearm">
    <visual>
      <origin xyz="0.075 0 0"/>
      <geometry>
        <box size="0.15 0.03 0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- JOINT 3: ELBOW -->
  <joint name="joint3" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0.15 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.0" upper="2.0"
           effort="5" velocity="1"/>
  </joint>

  <!-- LINK 4: WRIST -->
  <link name="wrist">
    <visual>
      <origin xyz="0.03 0 0"/>
      <geometry>
        <box size="0.06 0.025 0.025"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- JOINT 4: WRIST PITCH -->
  <joint name="joint4" type="revolute">
    <parent link="forearm"/>
    <child link="wrist"/>
    <origin xyz="0.15 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.57" upper="1.57"
           effort="5" velocity="1"/>
  </joint>

  <!-- END EFFECTOR -->
  <link name="tool_link"/>

  <joint name="tool_fixed" type="fixed">
    <parent link="wrist"/>
    <child link="tool_link"/>
    <origin xyz="0.06 0 0"/>
  </joint>

</robot>
