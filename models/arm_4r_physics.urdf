<robot name="robot_arm_4r">
  <link name="world" />
  <joint name="world_to_base" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <material name="blue">
    <color rgba="0.15 0.40 0.85 1.0" />
  </material>
  <material name="gray">
    <color rgba="0.55 0.55 0.55 1.0" />
  </material>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" />
      <geometry>
        <cylinder radius="0.06" length="0.05" />
      </geometry>
      <material name="gray" />
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <mass value="0.20" />
      <inertia ixx="0.000221667" ixy="0.0" ixz="0.0" iyy="0.000221667" iyz="0.0" izz="0.00036" />
    </inertial>
  </link>
  <link name="base_rotation">
    <visual>
      <origin xyz="0 0 0.05" />
      <geometry>
        <cylinder radius="0.035" length="0.10" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.10" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <mass value="0.15" />
      <inertia ixx="0.0001703125" ixy="0" ixz="0" iyy="0.0001703125" iyz="0" izz="0.000091875" />
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link" />
    <child link="base_rotation" />
    <origin xyz="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="5" velocity="1" />
  </joint>
  <link name="upper_arm">
    <collision>
      <origin xyz="0.075 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.035 0.035" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.075 0 0" rpy="0 0 0" />
      <mass value="0.10" />
      <inertia ixx="0.0000204167" ixy="0" ixz="0" iyy="0.0001977083" iyz="0" izz="0.0001977083" />
    </inertial>
    <visual>
      <origin xyz="0.075 0 0" />
      <geometry>
        <box size="0.15 0.035 0.035" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="base_rotation" />
    <child link="upper_arm" />
    <origin xyz="0 0 0.10" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.57" upper="1.57" effort="5" velocity="1" />
  </joint>
  <link name="forearm">
    <visual>
      <origin xyz="0.075 0 0" />
      <geometry>
        <box size="0.15 0.03 0.03" />
      </geometry>
      <material name="gray" />
    </visual>
    <collision>
      <origin xyz="0.075 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.03 0.03" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.075 0 0" rpy="0 0 0" />
      <mass value="0.08" />
      <inertia ixx="0.000012" ixy="0" ixz="0" iyy="0.000156" iyz="0" izz="0.000156" />
    </inertial>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="upper_arm" />
    <child link="forearm" />
    <origin xyz="0.15 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-2.0" upper="2.0" effort="5" velocity="1" />
  </joint>
  <link name="wrist">
    <visual>
      <origin xyz="0.03 0 0" />
      <geometry>
        <box size="0.06 0.025 0.025" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0.03 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.025 0.025" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.03 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.0000052083" ixy="0" ixz="0" iyy="0.0000176042" iyz="0" izz="0.0000176042" />
    </inertial>
  </link>
  <joint name="joint4" type="revolute">
    <parent link="forearm" />
    <child link="wrist" />
    <origin xyz="0.15 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.57" upper="1.57" effort="5" velocity="1" />
  </joint>
  <link name="tool_link" />
  <joint name="tool_fixed" type="fixed">
    <parent link="wrist" />
    <child link="tool_link" />
    <origin xyz="0.06 0 0" />
  </joint>
</robot>